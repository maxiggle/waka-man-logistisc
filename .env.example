# Firebase client SDK config (safe to expose to the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Mapbox token for address autocomplete/geocoding (src/lib/geocode.ts).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Firebase Admin service account, base64-encoded (src/server/firebaseAdmin.ts).
# NEVER prefix this with NEXT_PUBLIC_ and never commit a real value — it is
# root access to the whole Firebase project, bypassing every security rule.
# Generate: base64 < service-account.json
# Must also be set on Vercel for both Preview and Production environments.
FIREBASE_SERVICE_ACCOUNT_B64=

# Paystack (src/server/payments.ts). Use test keys (sk_test_/pk_test_) during
# development — never put live keys anywhere in this repo.
# Server only. Root access to your Paystack account — never prefix with NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY=sk_test_xxx
# Safe to expose; identifies the account to the checkout widget.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Optional. Address search queries Mapbox and Photon (OpenStreetMap) together:
# Mapbox has no POI coverage in Nigeria — landmarks like "Uniport" return
# nothing — while Photon does (src/lib/geocode.ts). Defaults to Komoot's
# public instance, which is community-run with no SLA and a fair-use
# expectation. Point this at a self-hosted Photon before relying on it in
# production; a Nigeria-only OSM extract is small enough to run cheaply.
NEXT_PUBLIC_PHOTON_URL=

# Resend API key for sending emails (e.g. APK download links)
RESEND_API_KEY=
# Sender must be on a domain verified in Resend.
RESEND_SENDER_EMAIL=no-reply@wakaman.xyz

# Absolute base URL of this application (used for generating absolute email links)
APP_ORIGIN=

# Direct download URL for the rider APK (e.g. GitHub Releases asset, Vercel Blob, R2).
# If set, redeemToken returns this link on redemption, bypassing Firebase Storage.
APK_DOWNLOAD_URL=

# Firebase Storage Bucket name (without gs://) (e.g. project-id.appspot.com)
FIREBASE_STORAGE_BUCKET=

# Firebase Storage path where the rider APK is stored manually or via CI (if using Firebase Storage)
APK_STORAGE_PATH=rider-app/app-release.apk


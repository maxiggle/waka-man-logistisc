# Copy to android/keystore.properties (gitignored, never commit) and fill in
# your release keystore's real values. Without this file, `assembleRelease`
# falls back to the machine-local debug key, which won't match the SHA-1
# registered in Firebase and breaks Google Sign-In on any other device.
storeFile=/absolute/path/to/your-release.jks
storePassword=
keyAlias=
keyPassword=

// Firestore security rules. Currently NOT deployed — there is deliberately
// no "rules" key in firebase.json yet (see the comment there). Verify
// against the Firebase emulator before adding it and deploying.
//
// The Admin SDK (src/server/*) bypasses these rules entirely — that's what
// lets the API routes keep working once client writes to the same paths
// are locked down here. See W3F2-T0.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isInvited(email) {
      return exists(/databases/$(database)/documents/adminInvites/$(email));
    }

    function isSuperAdminInvited(email) {
      return exists(/databases/$(database)/documents/superadminInvites/$(email));
    }

    // Superadmin ⊃ admin (WM-103): a superadmin is a strict superset of an
    // admin — delivery/rider oversight plus pricing control, not two
    // disjoint grants — so anywhere isAdmin() gates a read/write, a
    // superadmin qualifies too. isSuperAdmin() below stays the strict,
    // pricing-only check.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }

    // Distinct from isAdmin() on purpose (WM-101 Phase 2) — the strict,
    // pricing-only check. Use this to gate pricing-specific actions;
    // everything else that used to mean "admin" should keep using isAdmin(),
    // which a superadmin now also satisfies.
    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // --- users/{uid} (merged from firestore.rules.admin-invites) ---
    //
    // KNOWN GAP, discovered wiring this up: src/app/riders/page.tsx queries
    // the whole `users` collection (`where role == "rider"`) with no auth
    // gate at all today — a fully public rider directory. This rule (self
    // or admin only) breaks that page. That's a pre-existing tension in the
    // admin-invites draft this was merged from, not something introduced
    // here; resolve deliberately (gate the page behind sign-in and loosen
    // this to isSignedIn(), or move public-safe rider stats to their own
    // denormalized collection) rather than widening this rule to "any
    // signed-in user" without deciding — that would leak every user's
    // email address (stored on this same document) to every other user.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // A user may only write role: "admin"/"superadmin" onto their own doc
      // if their email currently has the matching invite — otherwise any
      // other role is fine to self-set (matches client/rider self-registration).
      allow create: if isSignedIn() && request.auth.uid == uid &&
        (request.resource.data.role != 'admin' || isInvited(myEmail())) &&
        (request.resource.data.role != 'superadmin' || isSuperAdminInvited(myEmail()));

      // deliveriesCompleted/ratingAvg/ratingCount are server-authoritative
      // (src/server/deliveryLifecycle.ts increments the first; the Admin
      // SDK bypasses this rule) — a client must never be able to move
      // either, including via their own otherwise-legitimate self-updates.
      // Self-writes only. There is deliberately no `|| isAdmin()` arm here.
      //
      // There used to be one, unconstrained, so that client-side invite
      // revocation could step a demoted user down by writing role onto
      // their document. It also let any admin write role: 'superadmin'
      // onto their OWN document — granting themselves pricing control
      // without an invite, which is precisely what superadminInvites
      // exists to gate — and let an admin forge the deliveriesCompleted /
      // ratingAvg / ratingCount values the self-arm below protects.
      // Confirmed exploitable against this ruleset before it was removed.
      //
      // Revocation now runs on the Admin SDK (src/server/invites.ts, via
      // /api/admin/invites), which bypasses these rules, so nothing
      // legitimate needs a client-side write to someone else's document.
      // Admins keep read access via the allow read above.
      allow update: if isSignedIn() &&
        request.auth.uid == uid &&
        (request.resource.data.role == resource.data.role ||
         (request.resource.data.role != 'admin' || isInvited(myEmail())) &&
         (request.resource.data.role != 'superadmin' || isSuperAdminInvited(myEmail()))) &&
        request.resource.data.get('deliveriesCompleted', 0) == resource.data.get('deliveriesCompleted', 0) &&
        request.resource.data.get('ratingAvg', 0) == resource.data.get('ratingAvg', 0) &&
        request.resource.data.get('ratingCount', 0) == resource.data.get('ratingCount', 0);
    }

    // Both invite collections are READ-ONLY to clients. Granting and
    // revoking run on the Admin SDK (src/server/invites.ts via
    // /api/admin/invites), because revocation has to step the demoted user
    // down — a write to someone else's users/{uid} doc that clients are no
    // longer permitted to make.
    //
    // Moving the writes also makes the superadmin guards real rather than
    // advisory: "you can't revoke yourself" and "you can't remove the last
    // superadmin" were enforced in browser code while these rules happily
    // allowed deleting the document directly.
    match /adminInvites/{email} {
      // Anyone can check their own invite status (needed on every sign-in);
      // only admins can browse the full list.
      allow get: if isSignedIn() && (myEmail() == email || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    match /superadminInvites/{email} {
      // Mirrors adminInvites, but listing is gated on isSuperAdmin() — an
      // ordinary admin has no business enumerating who holds pricing
      // control (see the isSuperAdmin() comment above).
      allow get: if isSignedIn() && (myEmail() == email || isSuperAdmin());
      allow list: if isSuperAdmin();
      allow write: if false;
    }

    match /riderAccessRequests/{uid} {
      // A user may read only their own request. Admins may read all requests.
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false; // Only server handles writes
    }

    match /apkDownloadTokens/{tokenId} {
      allow read, write: if false; // Only server handles these
    }

    // --- deliveries/{deliveryId} ---
    //
    // Read-only to every client. Creation moved server-side (W5-T4,
    // src/server/deliveries.ts via POST /api/deliveries) because the fare
    // has to be computed and frozen onto the document by something the
    // customer doesn't control; validating that through rules alone isn't
    // possible. Every write after creation — claim, status advance,
    // release, complete, payment — was already server-only
    // (src/server/dispatch.ts, src/server/deliveryLifecycle.ts,
    // src/server/payments.ts). The Admin SDK bypasses these rules entirely,
    // so denying all writes here costs the server nothing.
    match /deliveries/{deliveryId} {
      // The third arm covers a rider currently holding a live offer — they
      // are neither the client nor the assigned rider yet. The 'offeredTo'
      // in resource.data guard is required, not defensive noise: accessing
      // a missing field in a rules expression is an evaluation error, and
      // deliveries created before this change have no offeredTo field.
      allow read: if isSignedIn() &&
        (resource.data.clientId == request.auth.uid || resource.data.riderId == request.auth.uid || isAdmin()
          || ('offeredTo' in resource.data && request.auth.uid in resource.data.offeredTo));

      allow create, update, delete: if false;

      // The confirmation code: readable only by the owning client, never by
      // the assigned rider (see src/server/deliveryLifecycle.ts — completeDelivery
      // compares against this doc server-side only). Verified that a naive
      // recursive `{document=**}` rule on the parent leaks this to the
      // rider too — it must be named explicitly like this.
      //
      // The read is authorized against the PARENT delivery's clientId, not
      // this document's own. That reads like an unnecessary get() until you
      // consider the unpaid case: this document does not exist yet, so
      // `resource` is null, and `resource.data.clientId` is an evaluation
      // error — which Firestore surfaces as permission-denied. The customer
      // then sees "you don't have permission to view this delivery's code"
      // on their own delivery, when the truth is simply that they haven't
      // paid yet. Checking the parent gives the same answer whether or not
      // the code exists.
      //
      // An earlier version stored clientId here specifically to avoid a
      // get(), because booking wrote this doc in the same batch as the
      // parent and a get() can't see sibling writes in a batch. That
      // constraint is gone — only applySuccessfulPayment creates this now,
      // on the Admin SDK, long after the delivery exists. clientId stays on
      // the document for the server's own use.
      //
      // WRITES ARE FULLY DENIED, and that is load-bearing. This document
      // existing is what unlocks handover: completeDelivery treats its
      // absence as "not paid for yet". An earlier version of this rule let
      // a client create it (booking used to write the code in a batch with
      // the delivery, before W5-T2 moved it behind payment) — which meant a
      // customer could write their own code from the browser, read it back,
      // tell the rider, and take the delivery without paying. Only
      // applySuccessfulPayment (src/server/payments.ts) creates this, on
      // the Admin SDK, after Paystack confirms the charge cleared.
      match /private/{docId} {
        allow read: if isSignedIn() &&
          get(/databases/$(database)/documents/deliveries/$(deliveryId)).data.clientId == request.auth.uid;
        allow create, update, delete: if false;
      }

      // Payment attempts (src/server/payments.ts) are server-only in both
      // directions. Nothing in the UI needs them: the customer's payment
      // state is on the delivery itself, and these carry Paystack
      // references that should not be enumerable by a browser.
      match /paymentAttempts/{reference} {
        allow read, write: if false;
      }
    }

    // --- quotes/{quoteId} ---
    //
    // Server-only in both directions, same reasoning as paymentAttempts
    // above: POST /api/quotes (src/server/quotes.ts) creates these on the
    // Admin SDK and returns the priced result directly in its response, so
    // the client never needs to read the document itself, and a client
    // write here would be an unpriced quote nothing computed.
    match /quotes/{quoteId} {
      allow read, write: if false;
    }

    // --- config/pricing, pricingHistory/{id} (WM-101 Phase 2) ---
    //
    // Server-read only, in both directions — even for a signed-in
    // superadmin. The dashboard at /admin/pricing never reads Firestore
    // directly; it goes through /api/admin/pricing (GET/POST) and
    // /api/admin/pricing/history, all on the Admin SDK, which is what lets
    // this stay deny-all here rather than needing a rules-level notion of
    // "superadmin" for reads. Keeping margin structure out of anything a
    // browser can query is the point — the client only ever needs the
    // already-computed quote from /api/quotes.
    match /config/{docId} {
      allow read, write: if false;
    }
    match /pricingHistory/{entryId} {
      allow read, write: if false;
    }

    // --- riderAvailability/{uid} ---
    //
    // A rider may read and write only their own presence doc. Matching still
    // runs exclusively through src/server/dispatch.ts (Wave 3) — the one
    // client read is W4-T4's startup reconciliation, a rider checking
    // whether their own presence survived the app being closed. No one else
    // may read any rider's presence, and no rider may read another's.
    match /riderAvailability/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.riderId == uid &&
        request.resource.data.status in ['online', 'busy'];
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Service areas: readable by any signed-in user (the booking form and the
    // map both need the default centre), writable only by admins.
    match /serviceAreas/{areaId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }
  }
}
